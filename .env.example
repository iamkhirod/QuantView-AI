# QuantView AI — Environment Configuration Example
# Copy this file to .env and configure your variables

# Optional: Twelve Data API Key for fundamental intelligence & quotes
# If not provided, QuantView AI automatically uses its high-availability live feed fallback
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Cryptographic secret key for HMAC token signing (minimum 32 random characters recommended)
QUANTVIEW_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-in-production

# Permitted CORS origins (comma-separated list, or * for development)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Server host and port configuration
HOST=127.0.0.1
PORT=8000
